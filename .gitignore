# Data (KARD is CC BY 4.0 but is distributed by Mendeley Data, never commit it).
# Directories are re-included so that the .gitkeep placeholders keep the layout.
data/**/*
!data/**/
!data/**/.gitkeep

# Experiment outputs / weights
outputs/**/*
!outputs/**/
!outputs/**/.gitkeep
*.pt
*.pth
*.ckpt

# Python / tooling
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/
build/
dist/
